# Copy to .env.local. With NO Supabase vars set, the app runs in local dev mode:
# board state lives in .data/*.json (gitignored), seeded from
# data/fixtures/board-2026-08-26.json on first read. Set the Supabase vars to
# use a real database (required in production).

NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# The assistant drawer (/api/kitchen-ai) — spends money; without it the board
# works fine but the assistant returns an error.
ANTHROPIC_API_KEY=
